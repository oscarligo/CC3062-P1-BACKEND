services:
  db:
    image: postgres:15-alpine
    container_name: CC3062_P1_DB
    restart: always
    env_file:
      - .env
    ports:
      - "5432:5432"
    volumes:
      - db_data:/var/lib/postgresql/data
      - ./database/init.sql:/docker-entrypoint-initdb.d/init.sql
  backend:
    container_name: CC3062_P1_BACKEND
    restart: always
    env_file:
      - .env
    ports:
      - "${BACKEND_PORT}:8080"
    environment:
      - DATABASE_URL=${DATABASE_URL}
      - BACKEND_PORT=${BACKEND_PORT}
    depends_on:
      db:
        condition: service_healthy 

volumes:
  db_data: